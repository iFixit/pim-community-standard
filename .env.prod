XDEBUG_MODE=off
FLAG_FREE_TRIAL_ENABLED=0
FLAG_MARKETPLACE_ACTIVATE_ENABLED=1
FLAG_MARKETPLACE_FAKE_APPS_ENABLED=0
FLAG_CONNECT_APP_WITH_PERMISSIONS_ENABLED=0
